# Copy to .env. `bun run dev` and `docker compose` both read it.
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
# One-time code for creating the first admin at /setup
SETUP_TOKEN="generate-with-openssl-rand-base64-32"
# The URL people open the app at. Needed in Docker so form posts pass the origin check.
ORIGIN="http://localhost:3000"

# IANA timezone that decides "today" for service due dates. The app serves one region.
APP_TIMEZONE="America/Los_Angeles"

# AI runs on Workers AI through AI Gateway, called over HTTPS, so it works from anywhere.
CF_ACCOUNT_ID=""
# Cloudflare API token with Account > Workers AI > Read
CF_AI_TOKEN=""
AI_GATEWAY_ID="default"
# Comma-separated models admins can choose from; the first is the default. Workers AI: @cf/author/model, third-party: author/model.
AI_MODELS="@cf/moonshotai/kimi-k2.6,anthropic/claude-sonnet-4,openai/gpt-4.1"

# Optional: keep photos and manuals in an S3-compatible bucket (AWS S3, R2, MinIO…) instead of
# DATA_DIR/files. Setting S3_BUCKET turns it on and needs both keys. S3_ENDPOINT defaults to AWS.
# S3_BUCKET=""
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# Manual search. `docker compose up -d meilisearch` starts it for `bun run dev` too.
# Key: at least 16 bytes, e.g. `openssl rand -base64 32`. Compose points the app at the container.
MEILI_MASTER_KEY=""
MEILI_URL="http://localhost:7700"
